+class PlanAckAudio:
+    """PLAN_ACK_V1: durable, at-most-once playback admission per plan.
+
+    Claim is committed before enqueueing. A crash/stop/queue failure may omit
+    the acknowledgement, but later steps/restarts must not replay that plan.
+    This is a playback attempt record, not proof of audible output.
+    """
+
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        self._audio = None
+
+    def claim(self, plan_id, cmd_id):
+        if not (self.directory / 'plan_ack.enabled').is_file():
+            return None
+        for value in (plan_id, cmd_id):
+            if not isinstance(value, str) or not value.strip() or len(value) > 200:
+                raise ValueError('invalid plan/command identifier')
+        if self._audio is None:
+            path = self.directory / 'plan_ack.wav'
+            if path.stat().st_size > 2_100_000:
+                raise ValueError('plan acknowledgement WAV exceeds size limit')
+            with wave.open(str(path), 'rb') as wav:
+                channels, width, rate, frames = (
+                    wav.getnchannels(), wav.getsampwidth(),
+                    wav.getframerate(), wav.getnframes())
+                if (channels, width, rate) != (1, 2, 24000) or not 0 < frames <= rate * 10:
+                    raise ValueError('expected mono PCM16 24kHz WAV, at most 10 seconds')
+                raw = wav.readframes(frames)
+            if len(raw) != frames * width:
+                raise ValueError('incomplete acknowledgement WAV')
+            self._audio = (np.frombuffer(raw, dtype='<i2').astype(np.float32) / 32768.0, rate)
+        db = sqlite3.connect(str(self.directory / 'plan_ack.sqlite3'), timeout=0.2)
+        try:
+            with db:
+                db.execute('CREATE TABLE IF NOT EXISTS playback_claims ('
+                           'plan_id TEXT PRIMARY KEY, cmd_id TEXT NOT NULL, '
+                           'claimed_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)')
+                changed = db.execute(
+                    'INSERT OR IGNORE INTO playback_claims (plan_id,cmd_id) VALUES (?,?)',
+                    (plan_id, cmd_id)).rowcount
+        finally:
+            db.close()
+        return self._audio if changed == 1 else None
 
 
